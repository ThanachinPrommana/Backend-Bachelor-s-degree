generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL_POSTGRES_SUPABASE")
  directUrl = env("DATABASE_URL_MIGRATE")
}

/// *
///  * =====================
///  * Models
///  * =====================
model User {
  id                 String               @id @default(cuid())
  First_name         String
  Last_name          String
  Email              String               @unique
  Phone              String
  Password           String
  userType           UserType             @default(Buyer)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  image              String?
  publicId           String?
  Buyer              Buyer?
  Deposit            Deposit[]
  DocumentUpload     DocumentUpload[]
  Notification       Notification[]
  PasswordResetToken PasswordResetToken[]
  Payment            Payment[]
  PropertyPost       PropertyPost[]
  Seller             Seller?
}

model Buyer {
  id                    String                 @id @default(cuid())
  userId                String                 @unique
  DateofBirth           DateTime?
  Occupation            String?
  Monthly_Income        Float?
  Family_Size           Int?
  Preferred_Province    String?
  Preferred_District    String?
  Preferred_Subdistrict String?
  Parking_Needs         Parking_Needs?
  Nearby_Facilities     Nearby_Facilities?
  Lifestyle_Preferences Lifestyle_Preferences?
  Special_Requirements  String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  Booking               Booking[]
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Seller {
  id                 String         @id @default(cuid())
  userId             String         @unique
  National_ID        String         @unique
  Company_Name       String?
  RealEstate_License String?        @unique
  Status             Status_Seller  @default(PENDING)
  StartTime          DateTime?
  isBooked           Boolean        @default(false)
  nationalIdImage    String?
  publicId           String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  Booking            Booking[]
  DateTimeSlot       DateTimeSlot[]
  PropertyPost       PropertyPost[]
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([Status])
}

model Category {
  id           String         @id @default(cuid())
  name         String
  PropertyPost PropertyPost[]
}

model PropertyPost {
  id                     String                      @id @default(cuid())
  Property_Name          String
  Price                  Float
  Usable_Area            Float
  Land_Size              Float
  Bedrooms               Int
  Bathroom               Int
  Description            String
  Deposit_Amount         Float?
  LinkMap                String?
  Province               String
  District               String
  Subdistrict            String
  Address                String
  Total_Rooms            Int?
  Year_Built             String?
  Nearby_Landmarks       Nearby_Landmarks_list[]     @default([])
  Additional_Amenities   Additional_Amenities_list[] @default([])
  Parking_Space          Int?
  Sell_Rent              Sell_Rent
  Other_related_expenses String[]                    @default([])
  Link_line              String?
  Link_facbook           String?
  Name                   String?
  Phone                  String
  floor                  Int?
  NumberOfUnits          Int?                        @default(1)
  Status_post            Status_post                 @default(PENDING)
  userId                 String
  sellerId               String?
  categoryId             String?
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt
  Deposit_Percent        Float?
  DateTimeSlot           DateTimeSlot[]
  Deposit                Deposit[]
  DocumentUpload         DocumentUpload[]
  Image                  Image[]
  Payment                Payment[]
  Category               Category?                   @relation(fields: [categoryId], references: [id])
  seller                 Seller?                     @relation(fields: [sellerId], references: [id])
  user                   User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  PropertyUnit           PropertyUnit[]
  Video                  Video[]

  @@index([sellerId, createdAt])
  @@index([userId, createdAt])
  @@index([Status_post, createdAt])
  @@index([Province, District, Subdistrict])
}

model PropertyUnit {
  id             String           @id @default(cuid())
  Unit_Number    String
  Status         UnitStatus       @default(AVAILABLE)
  propertyPostId String
  Booking        Booking?
  Deposit        Deposit?
  DocumentUpload DocumentUpload[]
  Payment        Payment[]
  propertyPost   PropertyPost     @relation(fields: [propertyPostId], references: [id], onDelete: Cascade)

  @@unique([propertyPostId, Unit_Number])
  @@index([propertyPostId, Status])
}

model Deposit {
  id             String           @id @default(cuid())
  postId         String
  userId         String?
  Deposit_Status Status_Disposit
  Deposit_Amount Float
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  propertyUnitId String           @unique
  Post           PropertyPost     @relation(fields: [postId], references: [id], onDelete: Cascade)
  Unit           PropertyUnit     @relation(fields: [propertyUnitId], references: [id], onDelete: Cascade)
  User           User?            @relation(fields: [userId], references: [id])
  DocumentUpload DocumentUpload[]

  @@index([userId, createdAt])
  @@index([postId, Deposit_Status])
}

model DocumentUpload {
  id                 String         @id @default(cuid())
  DocumentName       String
  DocumentUrl        String
  CloudinaryPublicId String?
  Review_Status      Status_Review
  Rejection_Note     String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  userId             String
  depositId          String?
  postId             String?
  unitId             String?
  Deposit            Deposit?       @relation(fields: [depositId], references: [id])
  Post               PropertyPost?  @relation(fields: [postId], references: [id])
  unit               PropertyUnit?  @relation(fields: [unitId], references: [id], onDelete: SetNull)
  User               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  DateTimeSlot       DateTimeSlot[]

  @@index([postId])
  @@index([userId])
  @@index([unitId])
}

model Payment {
  id             String         @id @default(cuid())
  userId         String
  postId         String
  PaymentType    PaymentType
  Payment_Amount Float
  Payment_Slip   String
  Status         Status_payment
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  unitId         String?
  PropertyPost   PropertyPost   @relation(fields: [postId], references: [id], onDelete: Cascade)
  Unit           PropertyUnit?  @relation(fields: [unitId], references: [id], onDelete: SetNull)
  User           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([postId, Status])
}

model Notification {
  id             String             @id @default(cuid())
  userId         String
  referenceId    String?
  Title          String
  type           String             @default("general")
  targetUrl      String?
  readAt         DateTime?
  Message        String
  Status         NotificationStatus
  createdAt      DateTime           @default(now())
  relatedProcess String?
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, Status])
}

model Image {
  id             String        @id @default(cuid())
  asset_id       String?
  public_id      String?
  url            String
  secure_url     String?
  propertyPostId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  PropertyPost   PropertyPost? @relation(fields: [propertyPostId], references: [id], onDelete: Cascade)

  @@index([propertyPostId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Video {
  id         String        @id @default(cuid())
  asset_id   String?
  public_id  String?
  url        String
  secure_url String?
  postId     String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  post       PropertyPost? @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model DateTimeSlot {
  id               String          @id @default(cuid())
  startTime        DateTime
  endTime          DateTime
  isBooked         Boolean         @default(false)
  sellerId         String
  postId           String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  Booking          Booking?
  Post             PropertyPost?   @relation(fields: [postId], references: [id], onDelete: Cascade)
  Seller           Seller          @relation(fields: [sellerId], references: [id])
  DocumentUpload   DocumentUpload? @relation(fields: [documentUploadId], references: [id], onDelete: Cascade)
  documentUploadId String?

  @@index([sellerId, startTime])
  @@index([postId, startTime])
  @@index([isBooked])
}

model Booking {
  id                  String        @id @default(cuid())
  buyerId             String
  sellerId            String
  dateTimeSlotId      String        @unique
  isReminderSent      Boolean       @default(false)
  isDayOfAlertSent    Boolean       @default(false)
  isAtTimeAlertSent   Boolean       @default(false)
  finalSlipUrl        String?
  finalSlipUploadDate DateTime?
  bookingStatus       BookingStatus @default(CONFIRMED)
  propertyUnitId      String?       @unique
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  Buyer               Buyer         @relation(fields: [buyerId], references: [id])
  dateTimeSlot        DateTimeSlot  @relation(fields: [dateTimeSlotId], references: [id])
  propertyUnit        PropertyUnit? @relation(fields: [propertyUnitId], references: [id], onDelete: Cascade)
  Seller              Seller        @relation(fields: [sellerId], references: [id])

  @@index([buyerId, createdAt])
  @@index([sellerId, createdAt])
  @@index([bookingStatus, createdAt])
}

/// *
///  * =====================
///  * Enums
///  * =====================
enum UserType {
  Buyer
  Seller
  Admin
}

enum Status_Seller {
  PENDING
  APPROVED
  REJECTED
}

enum Status_Disposit {
  PENDING
  CONFIRMED
  REJECTED
}

enum Status_Review {
  PENDING
  APPROVED
  REJECTED
  HIDDEN
}

enum PaymentType {
  CREDIT_CARD
  QR
  STRIPE
}

enum Status_payment {
  PENDING
  CONFIRMED
  REJECTED
}

enum NotificationStatus {
  UNREAD
  READ
}

enum Nearby_Landmarks_list {
  BTS_MRT
  School
  Hospital
  Mall_Market
  Park
}

enum Additional_Amenities_list {
  Swimming_Pool
  Fitness_Center
  Co_working_Space
  Pet_Friendly
}

enum Sell_Rent {
  SALE
  RENT
}

enum Nearby_Facilities {
  BTS_MRT
  School
  Hospital
  Mall_Market
  Park_Nature
}

enum Parking_Needs {
  oneCar
  twoCars
  threePlus
  Not_required
}

enum Lifestyle_Preferences {
  Work_from_Home
  Have_Pets
  Need_a_Home_Office
  Like_Gardening
}

enum Status_post {
  PENDING
  CONFIRMED
  SOLD
  HIDDEN
  REJECTED
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  PENDING_FINAL_VERIFICATION
  COMPLETED
  CANCELLED
}

enum UnitStatus {
  AVAILABLE
  SOLD
  PENDING
}
