generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL_POSTGRES_SUPABASE")
  directUrl = env("DATABASE_URL_MIGRATE")
}

/**
 * =====================
 * Enums
 * =====================
 */
enum UserType {
  Buyer
  Seller
  Admin
}

enum FinancialReadiness {
  Low
  High
}

enum Status_Seller {
  PENDING
  APPROVED
  REJECTED
}

enum Status_Disposit {
  PENDING
  CONFIRMED
  REJECTED
}

enum Status_Review {
  PENDING
  APPROVED
  REJECTED
  HIDDEN
}

enum PaymentType {
  CREDIT_CARD
  QR
  STRIPE
}

enum Status_payment {
  PENDING
  CONFIRMED
  REJECTED
}

enum NegotiationStatus {
  PENDING
  SUCCESS
  FAILED
}

enum ContractStatus {
  PENDING
  SIGNED
  REJECTED
}

enum NotificationStatus {
  UNREAD
  READ
}

enum Nearby_Landmarks_list {
  BTS_MRT
  School
  Hospital
  Mall_Market
  Park
}

enum Additional_Amenities_list {
  Swimming_Pool
  Fitness_Center
  Co_working_Space
  Pet_Friendly
}

enum Sell_Rent {
  SALE
  RENT
}

enum Nearby_Facilities {
  BTS_MRT
  School
  Hospital
  Mall_Market
  Park_Nature
}

enum Parking_Needs {
  oneCar
  twoCars
  Not_required
}

enum Lifestyle_Preferences {
  Work_from_Home
  Have_Pets
  Need_a_Home_Office
  Like_Gardening
}

enum Status_post {
  PENDING // รอแอดมินอนุมัติ (สถานะเริ่มต้น)
  CONFIRMED // อนุมัติแล้ว (เทียบกับ AVAILABLE)
  SOLD // ขายไปแล้ว
  HIDDEN // ผู้ขายซ่อนไว้ชั่วคราว
  REJECTED // แอดมินไม่อนุมัติ
}

enum BookingStatus {
  PENDING_PAYMENT // รอจ่ายมัดจำ (ขั้นแรก)
  CONFIRMED // จ่ายมัดจำแล้ว
  PENDING_FINAL_VERIFICATION // รอสรุปยอดสุดท้าย
  COMPLETED // เสร็จสมบูรณ์
  CANCELLED
}

enum UnitStatus {
  AVAILABLE // ว่าง
  SOLD // ขายแล้ว
  RENTED // เช่าแล้ว
  PENDING // กำลังดำเนินการ
}

/**
 * =====================
 * Models
 * =====================
 */

model User {
  id         String   @id @default(cuid())
  First_name String
  Last_name  String
  Email      String   @unique
  Phone      String
  Password   String
  userType   UserType @default(Buyer)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  Buyer              Buyer?
  Seller             Seller?
  PropertyPost       PropertyPost[]
  Payment            Payment[]
  Notification       Notification[]
  PasswordResetToken PasswordResetToken[]
  image              String?
  publicId           String?
  Deposit            Deposit[]
  DocumentUpload     DocumentUpload[]
}

model Buyer {
  id                    String                 @id @default(cuid())
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                String                 @unique
  DateofBirth           DateTime?
  Occupation            String?
  Monthly_Income        Float?
  Family_Size           Int?
  Preferred_Province    String?
  Preferred_District    String?
  Preferred_Subdistrict String?
  Parking_Needs         Parking_Needs?
  Nearby_Facilities     Nearby_Facilities?
  Lifestyle_Preferences Lifestyle_Preferences?
  Special_Requirements  String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  Booking Booking[]

  @@index([userId])
}

model Seller {
  id                 String        @id @default(cuid())
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId             String        @unique
  National_ID        String        @unique
  Company_Name       String?
  RealEstate_License String?       @unique
  Status             Status_Seller @default(PENDING)
  StartTime          DateTime?
  isBooked           Boolean       @default(false)
  nationalIdImage    String?
  publicId           String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  DateTimeSlot DateTimeSlot[]
  Booking      Booking[]
  PropertyPost PropertyPost[]

  @@index([userId])
  @@index([Status])
}

model Category {
  id           String         @id @default(cuid())
  name         String
  PropertyPost PropertyPost[]
}

model PropertyPost {
  id            String @id @default(cuid())
  Property_Name String
  Price         Float
  Usable_Area   Float
  Land_Size     Float
  Bedrooms      Int
  Bathroom      Int
  Description   String

  Deposit_Amount Float? // สำหรับขาย (ดาวน์) 
  Deposit_Rent   Float? // สำหรับเช่า (มัดจำ) //เอาออก

  Contract_Seller        String? //เอาออก
  LinkMap                String?
  Latitude               Float? //เอาออก
  Longitude              Float? //เอาออก
  Province               String
  District               String
  Subdistrict            String
  Address                String
  Total_Rooms            Int?
  Year_Built             String?
  Nearby_Landmarks       Nearby_Landmarks_list[]     @default([])
  Additional_Amenities   Additional_Amenities_list[] @default([])
  Parking_Space          Int?
  Sell_Rent              Sell_Rent
  Other_related_expenses String?
  Link_line              String?
  Link_facbook           String?
  Name                   String?
  Phone                  String
  floor                  Int?
  NumberOfUnits          Int?                        @default(1)
  Interest               Float?
  Status_post            Status_post                 @default(PENDING)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  seller   Seller? @relation(fields: [sellerId], references: [id])
  sellerId String?

  Category   Category? @relation(fields: [categoryId], references: [id])
  categoryId String?

  Deposit   Deposit[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  Payment        Payment[]
  Image          Image[]
  DocumentUpload DocumentUpload[]
  Video          Video[]
  DateTimeSlot   DateTimeSlot[]
  PropertyUnit   PropertyUnit[]

  @@index([sellerId, createdAt])
  @@index([userId, createdAt])
  @@index([Status_post, createdAt])
  @@index([Province, District, Subdistrict])
}

model PropertyUnit {
  id             String       @id @default(cuid())
  Unit_Number    String
  Status         UnitStatus   @default(AVAILABLE)
  propertyPost   PropertyPost @relation(fields: [propertyPostId], references: [id])
  propertyPostId String

  DocumentUpload DocumentUpload[]
  Booking        Booking?
  Deposit        Deposit?

  @@unique([propertyPostId, Unit_Number])
  @@index([propertyPostId, Status])
}

model Deposit {
  id             String           @id @default(cuid())
  Post           PropertyPost     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId         String
  User           User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId         String?
  Deposit_Status Status_Disposit
  Deposit_Amount Float
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  Unit           PropertyUnit     @relation(fields: [propertyUnitId], references: [id])
  propertyUnitId String           @unique
  DocumentUpload DocumentUpload[]

  @@index([userId, createdAt])
  @@index([postId, Deposit_Status])
}

model DocumentUpload {
  id                 String        @id @default(cuid())
  DocumentName       String
  DocumentUrl        String
  CloudinaryPublicId String?
  Review_Status      Status_Review
  Rejection_Note     String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  User   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  Deposit   Deposit? @relation(fields: [depositId], references: [id])
  depositId String?

  Post   PropertyPost? @relation(fields: [postId], references: [id], onDelete: SetNull)
  postId String?

  unitId String?
  unit   PropertyUnit? @relation(fields: [unitId], references: [id], onDelete: SetNull)

  @@index([postId])
  @@index([userId])
  @@index([unitId])
}

model Payment {
  id             String         @id @default(cuid())
  User           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  PropertyPost   PropertyPost   @relation(fields: [postId], references: [id])
  postId         String
  PaymentType    PaymentType
  Payment_Amount Float
  Payment_Slip   String
  Status         Status_payment
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([userId, createdAt])
  @@index([postId, Status])
}

model Notification {
  id             String             @id @default(cuid())
  userId         String
  referenceId    String?
  Title          String
  type           String             @default("general")
  targetUrl      String?
  readAt         DateTime?
  Message        String
  Status         NotificationStatus
  createdAt      DateTime           @default(now())
  relatedProcess String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, Status])
}

model Image {
  id         String  @id @default(cuid())
  asset_id   String?
  public_id  String?
  url        String
  secure_url String?

  PropertyPost   PropertyPost? @relation(fields: [propertyPostId], references: [id], onDelete: Cascade)
  propertyPostId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([propertyPostId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}

model Video {
  id         String  @id @default(cuid())
  asset_id   String?
  public_id  String?
  url        String
  secure_url String?

  post      PropertyPost? @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([postId])
}

model DateTimeSlot {
  id        String   @id @default(cuid())
  startTime DateTime
  endTime   DateTime
  isBooked  Boolean  @default(false)

  Seller   Seller @relation(fields: [sellerId], references: [id])
  sellerId String

  Post   PropertyPost? @relation(fields: [postId], references: [id])
  postId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  Booking Booking?

  @@index([sellerId, startTime])
  @@index([postId, startTime])
  @@index([isBooked])
}

model Booking {
  id                  String        @id @default(cuid())
  Buyer               Buyer         @relation(fields: [buyerId], references: [id])
  buyerId             String
  Seller              Seller        @relation(fields: [sellerId], references: [id])
  sellerId            String
  dateTimeSlot        DateTimeSlot  @relation(fields: [dateTimeSlotId], references: [id])
  dateTimeSlotId      String        @unique
  isReminderSent      Boolean       @default(false)
  isDayOfAlertSent    Boolean       @default(false)
  isAtTimeAlertSent   Boolean       @default(false)
  finalSlipUrl        String?
  finalSlipUploadDate DateTime?
  bookingStatus       BookingStatus @default(CONFIRMED)
  propertyUnit        PropertyUnit? @relation(fields: [propertyUnitId], references: [id])
  propertyUnitId      String?       @unique
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([buyerId, createdAt])
  @@index([sellerId, createdAt])
  @@index([bookingStatus, createdAt])
}
